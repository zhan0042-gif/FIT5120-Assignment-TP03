# Copy this file to .env for local Docker Compose development.
MYSQL_DATABASE=fit5120
MYSQL_USER=fit5120_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Required only by the disposable migration service. Keep these independent
# from MYSQL_USER / MYSQL_PASSWORD; no migration credential has a repo default.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# Docker services reach MySQL by its Compose service name, not localhost.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Runtime adapters: MySQL persistence + processed spatial data by default.
APP_REPOSITORY_MODE=mysql
APP_SPATIAL_MODE=data
APP_SPATIAL_CACHE_MAX_AGE_HOURS=24
APP_OPEN_DATA_DB_CONNECT_TIMEOUT_SECONDS=5
APP_OPEN_DATA_DB_READ_TIMEOUT_SECONDS=15
APP_OPEN_DATA_DB_WRITE_TIMEOUT_SECONDS=10

# Use "mock" for deterministic local/API testing without live official feeds.
APP_DATA_MODE=live

# Required when APP_DATA_MODE=live. Obtain a TomTom API key; never commit its value.
TOMTOM_API_KEY=

# Required for live Victorian Unplanned Road Disruptions data.
# Never commit the real key.
VIC_ROAD_DISRUPTIONS_API_KEY=your_key_here

BACKEND_PORT=8000
MYSQL_EXPOSED_PORT=3306

# NVIDIA hosted-model key from build.nvidia.com, used for the rendezvous explanation.
# Optional: with no key the feature is disabled and the rest of the app runs normally.
AI_API_KEY=

# OpenAI key for the voice assistant (GPT-Live and the Decisions API).
# Optional: with no key voice is disabled and the rest of the app runs normally.
# Keep it on the server; never commit its value.
OPENAI_API_KEY=
